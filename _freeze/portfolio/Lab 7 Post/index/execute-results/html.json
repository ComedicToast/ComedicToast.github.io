    "engine": "knitr",
    "markdown": "---\ntitle: \"Lab 7 Blog Post\"\ndescription: \"Using APIs\"\nauthor:\n  - name: ComedicToast\n    url: https://github.com/ComedicToast.io\ndate: 5-18-2025\ncategories: [Quarto, R] # self-defined categories\nimage: thumbnail.jpg\ndraft: false # setting this to `true` will prevent your post from appearing on your listing page until you're ready!\n---\n\n::: {.cell}\n\n```{.r .cell-code}\n# load libraries\nlibrary(dplyr)\nlibrary(httr)\nlibrary(jsonlite)\nlibrary(tidyverse)\nlibrary(here)\nlibrary(leaflet)\n```\n:::\n\n\n\n\n### Load and Clean Data\n\n\n\n\n::: {.cell}\n\n```{.r .cell-code}\nstate_capitals <- read.table(here(\"data\", \"state_capitals_ll.txt\"))\nstate_capitals_name <- read.table(here(\"data\", \"state_capitals_name.txt\"))\nstate_capitals <- state_capitals %>% filter(!V1 %in% c(\"DC\", \"PR\", \"US\", \"AK\"))\n\nstate_capitals_clean <- state_capitals %>%\n  mutate(\n    state = V1,\n    latitudes = V2,\n    longitudes = V3\n  ) %>%\n  select(state, latitudes, longitudes)\n```\n:::\n\n\n\n\n# Pass Times for U.S State Capitals\n\n## Function 1 to get all relevant json info\n\n\n\n\n\n::: {.cell}\n\n```{.r .cell-code}\n# Function to get JSON info\nget_json_info_cleaned <- function(df) {\n  # pmap iterates by state, lat and long to get everything we need in a list\n  results <- purrr::pmap(df, function(state, latitudes, longitudes) {\n    url <- paste0(\"https://api.g7vrd.co.uk/v1/satellite-passes/25544/\", latitudes, \"/\", longitudes, \".json\")\n  # get results from the url\n    response <- GET(url)\n  # if there were no issues\n    if (http_status(response)$category == \"Success\") {\n      #grab the json char data\n      json_data <- fromJSON(rawToChar(response$content))\n      passes_data <- head(json_data$passes$tca, 3)\n      #store in a list\n      list(state = state, latitude = latitudes, longitude = longitudes, passes = passes_data)\n    } else {\n      #error message otherwise\n      warning(paste0(\"Error fetching data for \", state, \" (lat: \", latitudes, \", long: \", longitudes, \"): \", http_status(response)$message))\n      list(state = state, latitude = latitudes, longitude = longitudes, error = http_status(response)$message)\n    }\n  })\n  return(results)\n}\n```\n:::\n\n\n\n\n## Function 2 to convert it to a nice df\n\n\n\n\n::: {.cell}\n\n```{.r .cell-code}\napi_data_cleaned <- get_json_info_cleaned(state_capitals_clean)\n\n# Function to convert API data to a nice df \nconvert_api_to_df_cleaned <- function(api_data) {\n  # Extract core information using map_dfr for a data frame\n  df_core <- purrr::map_dfr(api_data, function(item) {\n    data.frame(\n      state = item$state,\n      latitude = item$latitude,\n      longitude = item$longitude\n    )\n  })\n\n  # grab passes and make sure all have 3, fill with NA if fewer\n  all_passes_padded <- purrr::map(api_data, function(item) {\n    passes <- item$passes\n    if (is.null(passes)) { # Handle cases where there might be an error and no passes\n      return(rep(NA_character_, 3))\n    }\n    length(passes) <- 3 # Pad with NA if less than 3, truncates if more than 3\n    return(passes)\n  })\n\n  # Convert the list of passes into df by rowbinding with do.call\n  passes_df <- as.data.frame(do.call(rbind, all_passes_padded))\n  colnames(passes_df) <- paste0(\"pass\", 1:ncol(passes_df))\n\n  # Combine the core data frame with the passes data frame\n  final_df <- cbind(df_core, passes_df)\n\n  return(final_df)\n}\n\nfinal_state_capitals_cleaned <- convert_api_to_df_cleaned(api_data_cleaned)\n```\n:::\n\n\n\n\n\n### Converting to Readable Times and Joining Capital Names\n\n\n\n\n::: {.cell}\n\n```{.r .cell-code}\nfinal_state_capitals <- final_state_capitals_cleaned %>%\n  inner_join(state_capitals_name, by = join_by(state == V1)) %>%\n  mutate(capital_name = V2,\n         pass1 = ymd_hms(pass1, tz = \"UTC\"),\n         pass2 = ymd_hms(pass2, tz = \"UTC\"),\n         pass3 = ymd_hms(pass3, tz = \"UTC\")) %>%\n  select(state, capital_name, latitude, longitude, pass1, pass2, pass3)\n```\n:::\n\n\n\n\n# Mapping the Data\n\n## Drawing the Route of the ISS\n\n### Sorting Pass Times\n\n\n\n\n::: {.cell}\n\n```{.r .cell-code}\nstate_capitals_sorted <- final_state_capitals[order(as.POSIXct(final_state_capitals$pass1)), ] \n```\n:::\n\n\n\n\n### Creating Icon for Cities\n\n\n\n\n::: {.cell}\n\n```{.r .cell-code}\nhelmet_icon <- makeIcon(\n  iconUrl = \"https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/assets/characters/nautilus/skins/skin03/images/nautilus_splash_tile_3.jpg\",\n  iconWidth = 15, \n  iconHeight = 15\n  )\n```\n:::\n\n\n\n\n### Leaflet Plot\n\n\n\n\n::: {.cell}\n\n```{.r .cell-code}\nleaflet() %>%\n  addTiles() %>%\n  addMarkers(lng = jitter(state_capitals_sorted$longitude, \n                          factor = 2), \n             lat = jitter(state_capitals_sorted$latitude,\n                          factor = 2), \n             icon = helmet_icon,\n             popup = paste(state_capitals_sorted$capital_name, \", \", state_capitals_sorted$state, \"<br>\",\n                           \"Time 1: \", state_capitals_sorted$pass1, \"<br>\",\n                           \"Time 2: \", state_capitals_sorted$pass2, \"<br>\",\n                           \"Time 3: \", state_capitals_sorted$pass3),\n             label = paste0(state_capitals_sorted$capital_name, \", \", state_capitals_sorted$state, \".\",  \" Soonest Pass Time: \", state_capitals_sorted$pass1)\n             ) %>%\n  addPolylines(lat = state_capitals_sorted$latitude, lng = state_capitals_sorted$longitude)\n```\n\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"leaflet html-widget html-fill-item\" id=\"htmlwidget-2fe83e7551e6fc91f8be\" style=\"width:100%;height:464px;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-2fe83e7551e6fc91f8be\">{\"x\":{\"options\":{\"crs\":{\"crsClass\":\"L.CRS.EPSG3857\",\"code\":null,\"proj4def\":null,\"projectedBounds\":null,\"options\":{}}},\"calls